{
  "id": "the-forest",
  "name": "The Forest",
  "description": "Survival horror multiplayer server",
  "imageSource": "public",
  "image": "jammsen/the-forest-dedicated-server:latest",
  "dataMount": "/theforest",
  "query": { "type": "a2s", "port": 27015 },
  "ports": [
    { "host": 8766, "container": 8766, "protocol": "udp" },
    { "host": 27015, "container": 27015, "protocol": "udp" },
    { "host": 27016, "container": 27016, "protocol": "udp" }
  ],
  "environment": [
    { "key": "SERVER_STEAM_ACCOUNT_TOKEN", "value": "", "pinned": true },
    { "key": "PUID", "value": "1000", "pinned": false },
    { "key": "PGID", "value": "1000", "pinned": false },
    { "key": "ALWAYS_UPDATE_ON_START", "value": "true", "pinned": false }
  ],
  "rcon": { "enabled": false },
  "resources": {
    "cpuLimit": 2,
    "memoryLimit": 4096
  }
}
