{
  "id": "rust",
  "name": "Rust",
  "description": "Open-world survival multiplayer server",
  "imageSource": "public",
  "image": "didstopia/rust-server:latest",
  "dataMount": "/steamcmd/rust",
  "query": { "type": "a2s", "port": 28015 },
  "ports": [
    { "host": 28015, "container": 28015, "protocol": "udp" },
    { "host": 28016, "container": 28016, "protocol": "tcp" },
    { "host": 28082, "container": 28082, "protocol": "tcp" }
  ],
  "environment": [
    { "key": "RUST_SERVER_NAME", "value": "My Rust Server", "pinned": true },
    { "key": "RUST_RCON_PASSWORD", "value": "changeme", "pinned": true },
    { "key": "RUST_SERVER_MAXPLAYERS", "value": "50", "pinned": false },
    { "key": "RUST_SERVER_SEED", "value": "12345", "pinned": false },
    { "key": "RUST_SERVER_WORLDSIZE", "value": "3500", "pinned": false },
    { "key": "RUST_RCON_WEB", "value": "1", "pinned": false }
  ],
  "rcon": { "enabled": true, "port": 28016, "password": "changeme" },
  "resources": {
    "cpuLimit": 4,
    "memoryLimit": 8192
  }
}
