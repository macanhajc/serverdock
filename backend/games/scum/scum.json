    {
      "host": 7778,
      "container": 7778,
      "protocol": "udp"
    },
    {
      "host": 7779,
      "container": 7779,
      "protocol": "udp"
    },
    {
      "host": 27015,
      "container": 27015,
      "protocol": "udp"
