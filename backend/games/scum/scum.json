{
  "id": "scum",
  "name": "SCUM",
  "description": "Open-world post-apocalyptic survival server. Windows-only server binary run under Wine/xvfb inside the container.",
  "imageSource": "public",
  "image": "ghcr.io/evilolaf/scum:latest",
  "storeUrl": "https://store.steampowered.com/app/513710/SCUM/",
  "dataMount": "/opt/scumserver",
  "query": {
    "type": "a2s",
    "port": 27015
  },
  "ports": [
    { "host": 7777, "container": 7777, "protocol": "udp" },
    { "host": 7777, "container": 7777, "protocol": "tcp" },
    { "host": 7778, "container": 7778, "protocol": "udp" },
    { "host": 7778, "container": 7778, "protocol": "tcp" },
    { "host": 7779, "container": 7779, "protocol": "udp" },
    { "host": 7779, "container": 7779, "protocol": "tcp" },
    { "host": 27015, "container": 27015, "protocol": "udp" },
    { "host": 27015, "container": 27015, "protocol": "tcp" }
  ],
  "environment": [
    { "key": "GAMEPORT", "value": "7777", "pinned": false },
    { "key": "QUERYPORT", "value": "27015", "pinned": false },
    { "key": "MAXPLAYERS", "value": "32", "pinned": false },
    { "key": "ADDITIONALFLAGS", "value": "", "pinned": false },
    { "key": "MEMORY_THRESHOLD_PERCENT", "value": "95", "pinned": false },
    { "key": "MEMORY_CHECK_INTERVAL", "value": "60", "pinned": false }
  ],
  "resources": {
    "cpuLimit": null,
    "memoryLimit": null
  },
  "rcon": {
    "enabled": false
  }
}
