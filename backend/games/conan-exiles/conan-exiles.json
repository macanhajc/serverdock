{
  "id": "conan-exiles",
  "name": "Conan Exiles",
  "description": "Open-world survival multiplayer server",
  "imageSource": "public",
  "image": "indifferentbroccoli/conan-exiles-enhanced-server-docker:latest",
  "dataMount": "/home/steam/server-files",
  "query": { "type": "a2s", "port": 27015 },
  "ports": [
    { "host": 7777, "container": 7777, "protocol": "udp" },
    { "host": 7778, "container": 7778, "protocol": "udp" },
    { "host": 27015, "container": 27015, "protocol": "udp" },
    { "host": 25575, "container": 25575, "protocol": "tcp" }
  ],
  "environment": [
    { "key": "SERVER_NAME", "value": "My Conan Server", "pinned": true },
    { "key": "SERVER_PASSWORD", "value": "changeme", "pinned": true },
    { "key": "RCON_PASSWORD", "value": "changeme", "pinned": true },
    { "key": "MAX_PLAYERS", "value": "40", "pinned": false },
    { "key": "PUID", "value": "1000", "pinned": false },
    { "key": "PGID", "value": "1000", "pinned": false },
    { "key": "UPDATE_ON_START", "value": "true", "pinned": false }
  ],
  "rcon": { "enabled": true, "port": 25575, "password": "changeme" },
  "resources": {
    "cpuLimit": 4,
    "memoryLimit": 8192
  }
}
